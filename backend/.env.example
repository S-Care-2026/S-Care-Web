# ──────────────────────────────────────────────────────────────
# S-Care backend — environment variables
#
# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored: never commit real credentials.
# On Render these are set by render.yaml / the service's Environment tab instead.
# ──────────────────────────────────────────────────────────────

# ── Server ──
# Render sets PORT itself; this is only for local runs.
PORT=3001
# development | production
NODE_ENV=development

# ── Auth ──
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# On Render it is generated automatically.
JWT_SECRET=your_jwt_secret_here

# ── PostgreSQL (Neon) ──
# Neon console → your project → Connect. Copy the URLs exactly as shown
# (keep ?sslmode=require and any other query parameters).
#
# Pooled connection — "Connection pooling" ON, host contains "-pooler".
# The API uses this at runtime; it's the one set on Render.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/scare_db?sslmode=require
# Direct connection — "Connection pooling" OFF.
# Only for migrations (schema changes, extensions, triggers), run from your machine:
#   psql "$DATABASE_URL_UNPOOLED" -v ON_ERROR_STOP=1 -f database/postgres/001_initial_schema.sql
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/scare_db?sslmode=require

# ── Redis ──
# Cache, latest readings, check-in deadlines, pub/sub (see database/README.md → Redis).
# On Render this is filled in automatically from the s-care-redis Key Value instance,
# which only accepts connections from Render services — not from your machine.
# For local runs, start your own Redis, e.g.:
#   docker run -d --name scare-redis -p 6379:6379 redis:7
REDIS_URL=redis://localhost:6379

# ── InfluxDB Cloud Serverless ──
# Time-series store for vitals, device status, location and motion samples.
#
# Region URL of your InfluxDB Cloud account, without a trailing slash
# (shown in the browser address bar after you log in), e.g.
#   https://us-east-1-1.aws.cloud2.influxdata.com
#   https://eu-central-1-1.aws.cloud2.influxdata.com
INFLUX_HOST=https://your-region.aws.cloud2.influxdata.com
# Load Data → API Tokens → Generate API Token → Custom API Token,
# with read + write on the two buckets below. The token is shown only once.
INFLUX_TOKEN=your_influx_api_token
# Bucket names (Load Data → Buckets). Create both before running the backend.
# Raw samples, short retention (e.g. 30 days)
INFLUX_DATABASE=scare_raw
# 1-minute aggregates, longer retention (e.g. 400 days)
INFLUX_DATABASE_1M=scare_1m

# ── MQTT broker (HiveMQ Cloud) ──
# The wearables publish to the broker; the backend subscribes as a client.
#
# HiveMQ Cloud console → your cluster → Overview: copy the host, use port 8883 (TLS).
MQTT_BROKER_URL=mqtts://your-cluster-id.s1.eu.hivemq.cloud:8883
# Cluster → Access Management → Credentials. Needs permission to subscribe to scare/devices/#
MQTT_USERNAME=your_broker_username
MQTT_PASSWORD=your_broker_password
# Topic root; bands publish to <prefix>/<device_uid>/<vitals|status|location|events|motion|ack>
MQTT_TOPIC_PREFIX=scare/devices
# Optional. Defaults to scare-backend-<NODE_ENV>.
# Set your own when running locally so you don't take over a teammate's broker session.
# MQTT_CLIENT_ID=scare-backend-yourname
