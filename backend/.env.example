# Environment
PORT=3001
NODE_ENV=development

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/scare_db

# JWT Secret (for future auth)
JWT_SECRET=your_jwt_secret_here

# MQTT broker (HiveMQ Cloud) the wearables publish to — the backend subscribes as a client
MQTT_BROKER_URL=mqtts://your-cluster-id.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your_broker_username
MQTT_PASSWORD=your_broker_password
MQTT_TOPIC_PREFIX=scare/devices
# Optional. Defaults to scare-backend-<NODE_ENV>; must be unique per running backend
# MQTT_CLIENT_ID=scare-backend-yourname
