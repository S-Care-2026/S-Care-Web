# Copy to frontend/.env.local for local runs. Vite reads it at build/dev start.
#
# Where the dashboard finds the S-Care backend when "Real bands" data is selected.
# Local backend: http://localhost:3001 (the default when unset)
# Render: the public URL of the s-care-backend service, set in the Render dashboard.
VITE_API_URL=http://localhost:3001
